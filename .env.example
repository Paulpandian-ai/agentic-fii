# Stock Analysis Platform Configuration

# Application Settings
APP_NAME=Stock Analysis Platform
DEBUG=false
LOG_LEVEL=INFO

# Agent Configuration
EXECUTION_MODE=parallel  # parallel or sequential
DEFAULT_LOOKBACK_DAYS=252

# Agent Weights for Overall Score (must sum to 1.0)
WEIGHT_FUNDAMENTAL=0.30
WEIGHT_TECHNICAL=0.25
WEIGHT_SENTIMENT=0.20
WEIGHT_RISK=0.25

# Risk Parameters
RISK_FREE_RATE=0.05

# Optional API Keys (for extended functionality)
# ALPHA_VANTAGE_API_KEY=your_api_key_here
# NEWS_API_KEY=your_api_key_here

# API Server (optional)
API_HOST=0.0.0.0
API_PORT=8000
